---
import { getCollection } from 'astro:content';
import BlogPostList from '../components/BlogPostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/gallery.scss';

import Marquee from '../components/Marquee.astro';

const posts = await getCollection('blog');
---

<BaseLayout title="さこちゃねる">
  <div class="home-page">
    <div class="home-page__announcement">
      <Marquee message="なんと令和にさこちゃねるが復活！" duration="15s" />
    </div>
    <div class="home-page__counter" aria-label="アクセスカウンター">
      total<span class="counter-frame">
        <img class="counter-image" src="gounter/count.php" alt="累計アクセス数">
      </span>
      today<span class="counter-frame">
        <img class="counter-image" src="gounter/today.php" alt="今日のアクセス数">
      </span>
      yesterday<span class="counter-frame">
        <img class="counter-image" src="gounter/yesterday.php" alt="昨日のアクセス数">
      </span>
      number<span class="counter-frame">
        <img class="counter-image" src="gounter/number.php/000123" alt="指定した数字">
      </span>
    </div>
    <BlogPostList posts={posts} />
  </div>
</BaseLayout>
